# Frontend-only environment
# The frontend calls the API server directly (default: https://api.beyraghmandegar.ir).
# Set VITE_API_BASE_URL= (empty) to use same-origin /api via the Vite dev proxy or Nginx.
VITE_API_BASE_URL=https://api.beyraghmandegar.ir
VITE_API_PROXY_TARGET=http://localhost:4000

# Neshan map key (platform.neshan.org) for the home page venue map.
# Public/client-exposed by design — restrict it to your domain(s) in the
# Neshan panel. Without it, the home page map section simply hides itself.
VITE_NESHAN_MAP_KEY=
