# =============================
# Application
# =============================

NODE_ENV=development
PORT=4000

# Production example:
# DB_STORAGE=/var/lib/beyragh/reservations.db
# BACKUP_DIR=/var/backups/beyragh

DB_STORAGE=./reservations.db
BACKUP_DIR=./backups


# =============================
# Sensitive reservation data
# =============================

# Development can remain false until
# the database migration is performed.
#
# Production must use:
# PII_ENCRYPTION_ENABLED=true
#
# Generate a 32-byte Base64 key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Never commit the real key.

PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=


# =============================
# Reverse proxy / CORS
# =============================

# Local development:
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173

# Production example:
# TRUST_PROXY=1
# CORS_ORIGINS=https://example.com


# =============================
# Admin authentication
# =============================

ADMIN_ORIGIN=http://localhost:4000
ADMIN_USERNAME=admin

# Generate with:
# node server/scripts/hash-admin-password.js "YOUR-STRONG-PASSWORD"

ADMIN_PASSWORD_HASH=

# Minimum 32 random characters.
# Never commit the real value.

ADMIN_SESSION_SECRET=



# =============================
# Customer portal / My Reservations
# =============================
#
# Enable only when secrets below are configured.
# Customer session cookies never contain the raw phone number.
# Reservation phone matching uses HMAC lookup.
#
# Development:
# CUSTOMER_ORIGIN=http://localhost:5173
#
# Production:
# CUSTOMER_ORIGIN=https://example.com
#
# Generate each secret as a strong random value.
# Never commit real secrets.

CUSTOMER_PORTAL_ENABLED=false
CUSTOMER_SESSION_SECRET=
CUSTOMER_LOOKUP_SECRET=
CUSTOMER_SESSION_TTL_SECONDS=604800
CUSTOMER_ORIGIN=http://localhost:5173
# =============================
# Maps
# =============================

NESHAN_API_KEY=


# =============================
# SMS
# =============================

SMS_PROVIDER=noop
SMS_TRANSACTIONAL_ENABLED=false


# =============================
# Reservation OTP
# =============================
#
# Foundation phase:
# keep false until Booking UI is wired.
#
# Production:
# OTP_RESERVATION_REQUIRED=true
# OTP_PROVIDER=smsir
# OTP_DEV_EXPOSE_CODE=false
# OTP_SECRET=<minimum-32-random-characters>
#
# OTP codes are never stored as plaintext.
# Phone numbers in OTP challenges are HMAC-digested.

OTP_RESERVATION_REQUIRED=false
OTP_PROVIDER=noop
OTP_SECRET=

OTP_CODE_TTL_SECONDS=180
OTP_GRANT_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

OTP_PHONE_WINDOW_SECONDS=900
OTP_PHONE_MAX_REQUESTS=5

# Development + noop only.
# Never enable in production.
OTP_DEV_EXPOSE_CODE=true

# SMS.ir Verify template used for OTP.
OTP_SMSIR_TEMPLATE_ID=
OTP_SMSIR_CODE_PARAMETER=Code


# SMS.ir
SMSIR_API_KEY=
SMSIR_BASE_URL=https://api.sms.ir/v1
SMSIR_SANDBOX_VERIFY_TEMPLATE_ID=
SMSIR_LINE_NUMBER=
SMSIR_ENV=sandbox
TICKET_QR_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
TICKET_CHECKER_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
TICKET_CHECKER_USERS_JSON=[]
