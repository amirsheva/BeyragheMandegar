[Unit]
Description=Beyragh Mandegar Backend
After=network.target

[Service]
Type=simple
User=beyragh
Group=beyragh
WorkingDirectory=/opt/beyragh/backend
Environment=NODE_ENV=production
EnvironmentFile=/opt/beyragh/backend/.env
Environment=HOST=127.0.0.1
Environment=PORT=4000
UMask=0077
ExecStart=/usr/bin/node /opt/beyragh/backend/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
